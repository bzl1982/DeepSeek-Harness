desktop/resources/node-runtime/

# 系统与日志
.DS_Store
*.log
*.tgz
*.zip
desktop/_dev_runtime/

# 本地构建日志
desktop/build-log*.txt

# CI 下载的 Mac 构建产物（不入库，由 Actions 云端构建）
desktop/ci-macos/

# 个人工作文档（不入库）
交接报告.md
